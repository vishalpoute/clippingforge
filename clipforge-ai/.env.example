# === ClipForge AI Environment ===

# Database (SQLite default for development; PostgreSQL for production)
DATABASE_URL=sqlite:///./data/clipforge.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipforge

# Background Jobs (APScheduler with SQLite for dev; Redis+Celery for production)
# REDIS_URL=redis://localhost:6379/0

# OmniRouter AI Service
OMNIROUTER_BASE_URL=http://localhost:20128/v1
OMNIROUTER_API_KEY=REPLACE_WITH_LOCAL_KEY
OMNIROUTER_MODEL=
OMNIROUTER_TIMEOUT_SECONDS=120
OMNIROUTER_MAX_CONCURRENT_REQUESTS=2
OMNIROUTER_MAX_RETRIES=3

# Security
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production

# Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=2048
MAX_RENDER_WORKERS=1

# FFmpeg (leave empty to use system PATH or tools/ffmpeg)
FFMPEG_PATH=tools/ffmpeg/ffmpeg.exe
FFPROBE_PATH=tools/ffmpeg/ffprobe.exe

# Google OAuth (future)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta OAuth (future)
META_APP_ID=
META_APP_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000
